{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poolgate-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {
    "required": ["MASTER_KEY"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POOL",
        "class_name": "PoolCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PoolCoordinator"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ROTATION_JOURNAL",
      "bucket_name": "poolgate-edge-rotation-journal"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
